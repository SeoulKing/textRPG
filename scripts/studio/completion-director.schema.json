{
  "type": "object",
  "additionalProperties": false,
  "required": ["reportId", "goalId", "action", "summary", "nextTaskIds", "tasks", "acceptanceEvidence", "blockedReason"],
  "properties": {
    "reportId": { "type": "string", "minLength": 1 },
    "goalId": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["continue", "follow_up", "ready_for_acceptance", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "nextTaskIds": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1 } },
    "tasks": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["localId", "title", "organization", "playerChange", "dependsOn", "scope", "capabilities", "checks", "acceptance", "surface"],
        "properties": {
          "localId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "organization": { "type": "string", "enum": ["director", "design", "narrative", "world", "character", "development", "quality"] },
          "playerChange": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "scope": {
            "type": "object", "additionalProperties": false, "required": ["read", "write"],
            "properties": {
              "read": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "write": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["static", "code", "content", "art", "ui", "export", "test", "browser", "publish"] } },
          "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "surface": { "type": "string", "enum": ["cli", "app"] }
        }
      }
    },
    "acceptanceEvidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["criterion", "completedTaskIds", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "completedTaskIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "summary"],
              "properties": { "path": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "blockedReason": { "type": ["string", "null"], "minLength": 1 }
  }
}