[sub_resource type="Shader" id="Shader_tile_grid"]
code = "shader_type spatial;
render_mode unshaded, depth_draw_never, cull_disabled;

uniform vec2 tile_count = vec2(32.0);

void fragment() {
	vec2 cell = UV * tile_count;
	vec2 dist = abs(fract(cell + 0.5) - 0.5);
	float nearest_line = min(dist.x, dist.y);
	ALBEDO = vec3(0.85, 0.95, 0.83);
	ALPHA = (1.0 - smoothstep(0.02, 0.055, nearest_line)) * 0.68;
}
"

