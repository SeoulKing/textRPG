PORT=3000
RUNTIME_DIR=
DATABASE_URL=
NEON_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM-led world expansion is deferred by default.
# Set ENABLE_LLM_WORLD_PLANNER=true and GEMINI_API_KEY to opt into the experimental planner.
ENABLE_LLM_WORLD_PLANNER=false
# Generated subway floors use Gemini whenever an API key exists.
# The mandatory floor-1 bandit encounter always requires GEMINI_API_KEY.
# Set false to use template fallback floors after the bandit encounter.
ENABLE_LLM_SUBWAY_EXPEDITION=true
ENABLE_CONTENT_STUDIO=true
CONTENT_STUDIO_ADMIN_TOKEN=replace-with-a-long-random-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Optional legacy OpenAI-compatible endpoint fallback.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
