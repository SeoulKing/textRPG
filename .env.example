PORT=3000
RUNTIME_DIR=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM-led world expansion is deferred by default.
# Set ENABLE_LLM_WORLD_PLANNER=true and GEMINI_API_KEY to opt into the experimental planner.
ENABLE_LLM_WORLD_PLANNER=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Optional legacy OpenAI-compatible endpoint fallback.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
